  "auth": {
    "provider": {
      "id": "flapcode",
      "name": "Flapcode",
      "api": "openai-responses",
      "oauth": false,
      "models": [
        {
          "id": "gpt-5.6-sol",
          "name": "GPT-5.6 Sol (Flapcode)",
          "api": "openai-responses",
          "input": [
            "text",
            "image"
          ],
          "reasoning": true,
          "contextWindow": 1000000,
          "maxTokens": 128000,
          "cost": {
            "input": 5,
            "output": 30,
            "cacheRead": 0.5,
            "cacheWrite": 6.25
          },
          "thinkingLevelMap": {
            "minimal": "low",
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          },
          "compat": {
            "supportsLongCacheRetention": false,
