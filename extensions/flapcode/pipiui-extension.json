  },
  "app": {
    "settings": {
      "scope": "app",
      "schema": {
        "type": "object",
        "properties": {
          "ext.flapcode.apiKey": {
            "type": "string",
            "format": "secret",
            "title": "API Key"
          },
          "ext.flapcode.baseUrl": {
            "type": "string",
            "default": "https://codex.takemoon.com/v1",
            "title": "Base URL"
          }
        }
      }
    },
    "ui": {
      "panels": [],
