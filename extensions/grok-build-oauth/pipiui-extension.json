{
  "id": "grok-build-oauth",
  "name": "Grok Build",
  "version": "0.2.0",
  "capabilities": [
    "bridge.emit",
    "invoke.agent",
    "stream.render"
  ],
  "auth": {
    "provider": {
      "id": "grok-build",
      "name": "Grok Build",
      "api": "openai-responses",
      "oauth": true,
      "models": []
    }
  },
  "agent": {
    "extension": "agent/index.js"
  },
  "host": {
    "entry": "agent/host.js",
    "description": "Stable host library entry for cross-host consumers (pi-coc); same broker/tier/images client as the tools, returns bytes+metadata. Content hash pinned by the bundled sync receipt (pipiui-host-receipt.json)."
  },
  "lifecycle": {
    "onDisable": "dispose-app-immediate; unmount-agent-on-next-session"
  },
  "defaultEnabled": true
}
