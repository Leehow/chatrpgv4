{
  "id": "grok-build-oauth",
  "name": "Grok Build",
  "version": "0.2.0",
  "capabilities": [
    "bridge.emit",
    "invoke.agent",
    "stream.render"
  ],
  "auth": {
    "provider": {
      "id": "grok-build",
      "name": "Grok Build",
      "api": "openai-responses",
      "oauth": true,
      "models": [
        {
          "id": "grok-4.6",
          "name": "Grok 4.6",
          "api": "openai-responses",
          "input": [
            "text",
            "image"
          ],
          "reasoning": true,
          "contextWindow": 500000,
          "capabilities": {
            "hostedTools": {
              "tools": [
                "web_search",
                "x_search",
                "code_interpreter"
              ]
            },
            "structuredOutputs": true,
            "inputFiles": true,
            "nativeSearch": {
              "tools": [
                "web_search",
                "x_search"
              ]
            }
          }
        },
        {
          "id": "grok-4-fast",
          "name": "Grok 4 Fast",
          "api": "openai-responses",
          "input": [
            "text"
          ],
          "reasoning": false,
          "contextWindow": 256000,
          "capabilities": {
            "hostedTools": {
              "tools": [
                "web_search",
                "x_search",
                "code_interpreter"
              ]
            },
            "structuredOutputs": true,
            "inputFiles": true,
            "nativeSearch": {
              "tools": [
                "web_search",
                "x_search"
              ]
            }
          }
        },
        {
          "id": "grok-code-fast-1",
          "name": "Grok Code Fast",
          "api": "openai-responses",
          "input": [
            "text"
          ],
          "reasoning": false,
          "contextWindow": 256000,
          "capabilities": {
            "hostedTools": {
              "tools": [
                "web_search",
                "x_search",
                "code_interpreter"
              ]
            },
            "structuredOutputs": true,
            "inputFiles": true,
            "nativeSearch": {
              "tools": [
                "web_search",
                "x_search"
              ]
            }
          }
        }
      ]
    }
  },
  "agent": {
    "extension": "agent/index.js"
  },
  "host": {
    "entry": "agent/host.js",
    "description": "Stable host library entry for cross-host consumers (pi-coc); same broker/tier/images client as the tools, returns bytes+metadata. Content hash pinned by the bundled sync receipt (pipiui-host-receipt.json)."
  },
  "lifecycle": {
    "onDisable": "dispose-app-immediate; unmount-agent-on-next-session"
  },
  "defaultEnabled": true
}