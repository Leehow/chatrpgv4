{
  "id": "image-gen",
  "name": "Image Generation",
  "version": "0.1.0",
  "capabilities": ["invoke.agent"],
  "agent": {
    "extension": "agent/index.js"
  },
  "app": {
    "ui": {
      "settingsSections": [
        {
          "id": "image-model",
          "title": "生图模型",
          "description": "选择生成头像与插图使用的模型",
          "entry": "app/settings-model.js"
        }
      ]
    }
  },
  "lifecycle": { "onDisable": "dispose-app-immediate; unmount-agent-on-next-session" },
  "defaultEnabled": true
}
