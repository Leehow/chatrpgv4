{
  "id": "image-gen",
  "name": "Image Generation",
  "version": "0.1.0",
  "capabilities": ["invoke.agent"],
  "agent": {
    "extension": "agent/index.js"
  },
  "app": {
    "ui": {
      "settingsSections": [
        {
          "id": "image-model",
          "title": "Image Model",
          "description": "Choose the model used to generate portraits and illustrations",
          "entry": "app/settings-model.js"
        }
      ]
    }
  },
  "lifecycle": { "onDisable": "dispose-app-immediate; unmount-agent-on-next-session" },
  "defaultEnabled": true
}
