     "arguments": {
      "action": {
       "intent": "investigate",
       "goal": "Find the 1852 lawsuit in which neighbors tried to force Walter Corbitt out of the house.",
       "method": "Continue at the same reading table, following Walter Corbitt's name through bound court notices and neighborhood complaints.",
       "skill": "Library Use",
