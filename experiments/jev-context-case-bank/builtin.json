  "cases": [
    {
      "id": "newspaper-interest-vs-travel",
      "title": "报纸兴趣与明确旅行",
      "dimensions": [
        "public-spatial-scope"
      ],
      "origin": "authored-source-grounded",
      "grounding": [
        "newspaper-vague",
        "newspaper-proposal",
        "newspaper-explicit",
        "newspaper-access"
      ],
      "questions": {
        "travel": {
          "type": "choice",
          "instructions": "Does the current player request choose travel to the proposed destination? Assess destination choice separately from other proposed effects.",
          "criteria": {
            "chosen": "The destination is chosen.",
            "unchosen": "The destination is not chosen."
          }
        },
        "batch": {
          "type": "choice",
          "instructions": "Can every effect in the proposed batch be settled from the supplied choices and established events? Permission to attempt is not evidence of completed acquisition.",
          "criteria": {
            "ready": "All effects have sufficient authority and established outcome.",
            "not_ready": "At least one effect lacks authority or an established outcome."
          }
        }
      },
      "arms": [
        {
          "id": "interest",
          "label": "只提兴趣",
          "intervention": "只变player_text；前提、材料、提案相同。",
          "input": {
            "player_text": "那看看报纸",
            "situation": "已接科比特宅调查委托，尚未出发，也尚未取得剪报室访问许可或完成检索。工作人员可能限制访问。提案中的分钟数是待审定的计划参数，不是已经发生的耗时。",
            "existing_material": [
              "newspaper-premise"
            ],
            "candidates": [],
            "cache_only": [],
            "proposed_effects": [
              {
                "kind": "move",
                "to": "newspaper-morgue",
                "travel_minutes": 30
              },
              {
                "kind": "clue",
                "clue": "globe-unpublished-story"
              },
              {
                "kind": "time",
                "minutes": 45
              }
            ]
          },
          "expected": {
            "answers": {
              "travel": "unchosen",
              "batch": "not_ready"
            },
            "source_refs": [
              "newspaper-vague",
              "newspaper-proposal"
            ],
            "rationale": "未选择去处，不能由报纸兴趣代选旅行。"
          }
        },
        {
          "id": "travel",
          "label": "明确去剪报室",
          "intervention": "只变player_text；引用真实措辞但不搬用原回合全部状态。",
          "input": {
            "player_text": "我去环球报的剪报室查这栋房子的旧闻。",
            "situation": "已接科比特宅调查委托，尚未出发，也尚未取得剪报室访问许可或完成检索。工作人员可能限制访问。提案中的分钟数是待审定的计划参数，不是已经发生的耗时。",
            "existing_material": [
              "newspaper-premise"
            ],
            "candidates": [],
            "cache_only": [],
            "proposed_effects": [
              {
                "kind": "move",
                "to": "newspaper-morgue",
                "travel_minutes": 30
              },
              {
                "kind": "clue",
                "clue": "globe-unpublished-story"
              },
              {
                "kind": "time",
                "minutes": 45
              }
            ]
          },
          "expected": {
            "answers": {
              "travel": "chosen",
              "batch": "not_ready"
            },
            "source_refs": [
              "newspaper-explicit",
              "newspaper-access",
              "newspaper-proposal"
            ],
            "rationale": "明确选择旅行；不等于受限访问和发现未刊稿已成功，也不证明45分钟检索已发生。附加clue不能结算，不抹去旅行选择。"
          }
        }
      ],
      "design_notes": [
        "受控设计，非真桌A/B：模糊句来自合成契约测试，明确句来自另一上下文的真实turn。本次统一为尚未出发、尚未取得访问许可，也尚未完成检索。固定move/clue/time提案；只改变玩家措辞。时间参数是测试提案，不是已发生或必然耗时。"
      ]
    },
    {
      "id": "house-outside-vs-inside",
      "title": "同一场景标识不消除宅外与室内边界",
      "dimensions": [
        "public-spatial-scope"
      ],
      "origin": "live-derived",
      "grounding": [
        "house-player",
        "house-exterior",
        "house-cupboard",
        "house-diary-route",
        "house-accepted-move",
        "house-refused-extra"
      ],
      "questions": {
        "entry": {
          "type": "choice",
          "instructions": "Does the current request choose entry into the building interior, considering physical scope rather than scene identifier alone?",
          "criteria": {
            "chosen": "Interior entry is chosen.",
            "unchosen": "Interior entry is not chosen."
          }
        },
        "diary": {
          "type": "choice",
          "instructions": "Do current choices and established events authorize settling the proposed diary acquisition?",
          "criteria": {
            "ready": "Acquisition is supported by the supplied choices and completed events.",
            "not_ready": "Entry or observation alone does not establish the acquisition."
          }
        }
      },
      "arms": [
        {
          "id": "outside",
          "label": "外部巡视",
          "intervention": "只改变player_text，固定资料与提案。",
          "input": {
            "player_text": "天亮以后我先到科比特宅外面走一圈，看看房子的外观和周围街道。",
            "situation": "调查员当前在科比特宅外，尚未搜索室内。场景标识为corbitt-house-ground；守秘人收到的该场景资料也包含地上层调查路线，但资料投影本身不表示角色已进入或发现物品。",
            "existing_material": [
              "house-spatial"
            ],
            "candidates": [],
            "cache_only": [],
            "proposed_effects": [
              {
                "kind": "move",
                "to": "corbitt-house-ground",
                "via": "Enter the ground-floor interior"
              },
              {
                "kind": "clue",
                "clue": "corbitt-diaries"
              }
            ]
          },
          "expected": {
            "answers": {
              "entry": "unchosen",
              "diary": "not_ready"
            },
            "source_refs": [
              "house-player",
              "house-exterior",
              "house-cupboard",
              "house-diary-route",
              "house-accepted-move",
              "house-refused-extra"
            ],
            "rationale": "外部巡视允许到宅外，不允许代选入内、撬柜、取得日记。真实首批因附加研究线索被拒，随后move/time成功；不是整段旅行非法。"
          }
        },
        {
          "id": "inside",
          "label": "明确进屋",
          "intervention": "作者设计扰动，仅将行动范围改为进入；不是历史第二臂。",
          "input": {
            "player_text": "我先进入科比特宅的一层，看看里面的布局。",
            "situation": "调查员当前在科比特宅外，尚未搜索室内。场景标识为corbitt-house-ground；守秘人收到的该场景资料也包含地上层调查路线，但资料投影本身不表示角色已进入或发现物品。",
            "existing_material": [
              "house-spatial"
