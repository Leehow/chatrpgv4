#!/usr/bin/env bash
# Install UI assets only; the launcher reads the canonical source in this checkout.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
DEST="$REPO/.pi/coc-agent/extensions/coc-keeper"
mkdir -p "$DEST/pipicoc"
mkdir -p "$DEST/pipicoc/assets"
cp "$HERE/assets/paper-texture.jpg" "$DEST/pipicoc/assets/"
cp "$REPO/pipiui-extension.json" "$DEST/"
for asset in preparation.js panel.js mods-panel.js mods.ts mechanics.js choices.js host-bridge.ts sheet.ts agent.ts sheet-icon.svg; do
  cp "$HERE/$asset" "$DEST/pipicoc/"
done
printf 'Installed PipiCOC UI assets at %s\n' "$DEST"

# DeepSeek Extended provider: the whole tree (manifest + plain-JS agent half)
# feeds the app's model picker, settings section and generic auth-provider
# registration. Idempotent: replace the copy wholesale.
DS_DEST="$REPO/.pi/coc-agent/extensions/deepseek"
rm -rf "$DS_DEST"
mkdir -p "$DS_DEST"
cp -R "$REPO/extensions/deepseek/." "$DS_DEST/"
printf 'Installed DeepSeek Extended provider at %s\n' "$DS_DEST"
