#!/bin/bash
# Install compiled UI entries into the bound Pi profile without changing account configuration.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PI_COC_RESOURCE_ROOT="$root"
if [ -f "$root/deployment.json" ] || [ "${PI_COC_LAYOUT:-}" = compiled ]; then
  export PI_COC_LAYOUT=compiled
  unset NODE_OPTIONS NODE_PATH ELECTRON_RUN_AS_NODE
  runner="$root/node/bin/node"
  [ -x "$runner" ] || { echo 'The standalone COC runtime is incomplete.' >&2; exit 1; }
else
  export PI_COC_LAYOUT=source
  runner="${PI_COC_NODE_EXECUTABLE:-$(command -v node)}"
fi
[ -f "$root/build/runtime/host.mjs" ] || { echo 'Run npm run build:runtime before installing COC UI assets.' >&2; exit 1; }
export PI_COC_NODE_EXECUTABLE="$runner"
exec "$runner" --input-type=module - "$root" <<'JS'
import {accessSync,chmodSync,constants,copyFileSync,existsSync,lstatSync,mkdirSync,readdirSync,readFileSync,writeFileSync} from 'node:fs';
import {join} from 'node:path';
import {pathToFileURL} from 'node:url';
const root=process.argv[2];
const {composeRuntimeContext}=await import(pathToFileURL(join(root,'build/runtime/host.mjs')).href);
const compiled=existsSync(join(root,'deployment.json'));
if(compiled&&(!process.env.PI_COC_HOME||!process.env.PI_CODING_AGENT_DIR))throw new Error('Standalone installation requires its writable profile and COC home');
const context=composeRuntimeContext({owner:'preparation',home:process.env.PI_COC_HOME||root},{resourceRoot:root,
  agentHome:compiled?process.env.PI_CODING_AGENT_DIR:join(root,'.pi/coc-agent')});
for(const path of [context.entrypoints.agent,context.entrypoints.deepseek])accessSync(path,constants.R_OK);
function generatedDirectory(path){
  if(existsSync(path)&&lstatSync(path).isSymbolicLink())throw new Error(`Generated asset directory must not be a symbolic link: ${path}`);
  mkdirSync(path,{recursive:true});chmodSync(path,0o755);
}
function writableGeneratedFile(path){
  const entry=lstatSync(path,{throwIfNoEntry:false});
  if(!entry)return;
  if(!entry.isFile()||entry.isSymbolicLink())throw new Error(`Generated asset must be a regular file: ${path}`);
  chmodSync(path,0o644);
}
function copyGeneratedFile(source,destination){
  writableGeneratedFile(destination);copyFileSync(source,destination);chmodSync(destination,0o644);
}
function copyGeneratedTree(source,destination){
  generatedDirectory(destination);
  for(const name of readdirSync(source)){
    const from=join(source,name),to=join(destination,name),entry=lstatSync(from);
    if(entry.isDirectory())copyGeneratedTree(from,to);
    else if(entry.isFile())copyGeneratedFile(from,to);
    else throw new Error(`Unsupported generated asset: ${from}`);
  }
}
function writeGeneratedManifest(path,value){
  writableGeneratedFile(path);writeFileSync(path,JSON.stringify(value,null,2)+'\n');chmodSync(path,0o644);
}
const destination=join(context.agentHome,'extensions/coc-keeper');
for(const path of [join(context.agentHome,'extensions'),destination,join(destination,'pipicoc'),join(destination,'pipicoc/assets')])generatedDirectory(path);
for(const asset of ['preparation.js','panel.js','mods-panel.js','mechanics.js','choices.js','timeline.js','sheet-icon.svg','timeline.svg'])
  copyGeneratedFile(join(root,'pipicoc',asset),join(destination,'pipicoc',asset));
copyGeneratedFile(join(root,'pipicoc/assets/paper-texture.jpg'),join(destination,'pipicoc/assets/paper-texture.jpg'));
copyGeneratedFile(context.entrypoints.agent,join(destination,'pipicoc/agent.mjs'));
const manifest=JSON.parse(readFileSync(join(root,'pipiui-extension.json'),'utf8'));
manifest.agent.extension='pipicoc/agent.mjs';
writeGeneratedManifest(join(destination,'pipiui-extension.json'),manifest);
const provider=join(context.agentHome,'extensions/deepseek');
copyGeneratedTree(join(root,'extensions/deepseek'),provider);
copyGeneratedFile(context.entrypoints.deepseek,join(provider,'agent/index.mjs'));
const providerManifest=JSON.parse(readFileSync(join(provider,'pipiui-extension.json'),'utf8'));
providerManifest.agent.extension='agent/index.mjs';
writeGeneratedManifest(join(provider,'pipiui-extension.json'),providerManifest);
console.log(`Installed compiled COC and provider UI assets at ${context.agentHome}`);
JS
