    }
   ],
   "backstory": {
    "personal_description": "看起来三十多岁，鹅蛋脸，灰绿色眼睛，深褐头发齐肩、常随意挽在耳后。眉峰偏直，左眉尾有一小颗浅痣。常穿深色开领羊毛衫或衬衫，肩上挂着相机带，表情专注而安静。",
    "ideology_beliefs": "真相值得被看见，镜头和笔记比拳头更靠得住。",
    "significant_people": "已故律师马丁·海沃森——父亲多年的法律顾问与家族老友；父亲本人仍在阿卡姆一带。",
    "meaningful_locations": "阿卡姆自己那间堆满底片与剪报的小工作室，以及常去翻旧报的市立图书馆角落。",
    "treasured_possessions": "一台用了多年的折合式相机，和一本记满人物线索的皮质笔记本。",
    "traits": "耐得住冷板凳查档，不爱硬碰硬；枪只够自保水平。",
    "scenario_bound": "读到《阿卡姆消息人》关于海沃森遗体被盗的报道后，因家族私交自行动身调查。",
    "concept": "父亲老友马丁·海沃森遗体被盗后自行介入的摄影记者，靠观察与资料追查真相"
   },
   "key_connection": {
    "backstory_field": "significant_people",
    "summary": "马丁·海沃森：父亲多年的律师与家族老友，其遗体被盗是她介入的直接理由"
   },
