      "equipment": [
        {
          "name": "笔记本与短铅笔",
          "quantity": 1,
          "object_id": "object-item-1",
          "description": "一本随身带的薄笔记本和一支磨短的铅笔。翻开的横格纸上还是空的，等着记下时间、门牌和姓名。"
        },
        {
          "name": "开锁工具一套",
          "quantity": 1,
          "object_id": "object-item-2",
          "description": "一卷缝在皮套里的帆布，展开后插着七件钢制小工具：长短不一的撬杆、一张钩片、一把张力扳手和一个末端扁平的撬头。对付寻常门锁、挂锁和简单的抽屉栓扣绰绰有余，但遇上保险柜或锈死的重锁就只能干瞪眼。要真让它帮上忙，你手上得有开锁的门道——工具不会自己动手。"
        },
        {
          "name": "手电筒",
          "quantity": 1,
          "object_id": "object-item-3",
          "description": "一支金属筒身的手电筒，尾部旋盖里装着两节一号电池，按住筒身上的铜片就亮。光柱偏窄、发黄，电池满的时候能照清十几码外的东西；开久了会发烫，电池也撑不了几小时。要换电池或灯泡得旋开尾盖或灯头，花上一分钟左右。除了照明，它没别的用处。"
        },
        {
          "name": "唬人用徽章",
          "quantity": 1,
          "object_id": "object-item-4",
          "description": "你的镍合金盾形徽章，正面压着模糊的市府纹章和「BOSTON」。它磨得发亮，没有编号，也没有发证机关。对着文职办事员一晃，多半比真警察的证件还好使——他们只认得银光和架势。碰上真警察、记者或律师，这层皮就不顶用了。"
        },
        {
          "name": "科比特宅钥匙",
          "quantity": 1,
          "object_id": "object-item-5",
          "description": "诺特拍在桌上的那把钥匙：黄铜齿匙，齿口磨得发亮，穿在一枚细环上。他说这是科比特宅正门的钥匙——门锁是原装的，一直没换过。它开的就是那扇正门；别的门、地下室门栓或上了挂锁的地方，它都插不进去。"
        },
        {
          "name": "科比特宅地址纸条",
          "quantity": 1,
          "object_id": "object-item-6",
          "description": "一张对折的白纸条。展开后是你委托人亲笔写下的科比特宅地址，下面一行短话，末尾签着姓名缩写。纸薄而旧，折痕发亮——它只是一张纸条，没有别的用处。"
        }
      ],
