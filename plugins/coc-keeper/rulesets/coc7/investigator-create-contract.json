{
  "schema_version": 1,
  "kind": "investigator_create_payload_contract",
  "ruleset_id": "coc7",
  "ruleset_version": "1.0.0",
  "investigator_schema_version": 2,
  "runtime_authority": {
    "authoritative_validator": "plugins/coc-keeper/scripts/coc_character.py",
    "schema_role": "upfront machine-readable construction guidance",
    "note": "This schema describes the supported payload shapes. Existing deterministic runtime materialization, arithmetic, derived-value consistency, creation-method validation, and state-write checks remain authoritative."
  },
  "payload_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "COC7 investigator.create payload",
    "description": "Complete payload passed as setup.invoke payload when kind is investigator.create. The runtime also requires sheet.id to equal investigator_id; JSON Schema cannot express that cross-field equality.",
    "oneOf": [
      {
        "title": "Deterministic Quick Fire input",
        "type": "object",
        "required": [
          "campaign_id",
          "investigator_id",
          "sheet",
          "creation"
        ],
        "properties": {
          "campaign_id": {
            "$ref": "#/$defs/safe_id",
            "description": "Current campaign that owns this Quick Fire creation and its canonical Luck receipt."
          },
          "investigator_id": {
            "$ref": "#/$defs/safe_id"
          },
          "sheet": {
            "$ref": "#/$defs/quick_fire_sheet"
          },
          "creation": {
            "$ref": "#/$defs/quick_fire_creation"
          }
        },
        "additionalProperties": false
      },
      {
        "title": "Explicit complete-sheet import",
        "type": "object",
        "required": [
          "investigator_id",
          "sheet",
          "creation"
        ],
        "properties": {
          "investigator_id": {
            "$ref": "#/$defs/safe_id"
          },
          "sheet": {
            "$ref": "#/$defs/complete_sheet"
          },
          "creation": {
            "$ref": "#/$defs/complete_sheet_creation"
          }
        },
        "additionalProperties": false
      }
    ],
    "$defs": {
      "safe_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "description": "Stable safe id. sheet.id must contain the same string."
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*",
        "description": "Non-empty investigator name."
      },
      "age": {
        "type": "integer",
        "minimum": 15,
        "maximum": 89,
        "description": "Optional age supported by the current COC7 age-adjustment brackets when creation arithmetic is evaluated."
      },
      "characteristics": {
        "type": "object",
        "required": [
          "STR",
          "CON",
          "SIZ",
          "DEX",
          "APP",
          "INT",
          "POW",
          "EDU"
        ],
        "properties": {
          "STR": {
            "type": "integer"
          },
          "CON": {
            "type": "integer"
          },
          "SIZ": {
            "type": "integer"
          },
          "DEX": {
            "type": "integer"
          },
          "APP": {
            "type": "integer"
          },
          "INT": {
            "type": "integer"
          },
          "POW": {
            "type": "integer"
          },
          "EDU": {
            "type": "integer"
          }
        },
        "additionalProperties": true,
        "description": "The eight required COC7 characteristic keys. Method-specific arrays, budgets, and derived arithmetic are checked by the runtime."
      },
      "derived": {
        "type": "object",
        "required": [
          "HP",
          "MP",
          "SAN",
          "Luck",
          "DB",
          "Build",
          "MOV"
        ],
        "properties": {
          "HP": {
            "type": "integer"
          },
          "MP": {
            "type": "integer"
          },
          "SAN": {
            "type": "integer"
          },
          "Luck": {
            "type": "integer"
          },
          "DB": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              }
            ],
            "description": "Damage bonus. Canonical zero is the string \"none\"; runtime derived-value consistency is authoritative."
          },
          "Build": {
            "type": "integer"
          },
          "MOV": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      },
      "skills": {
        "type": "object",
        "required": [
          "Credit Rating"
        ],
        "propertyNames": {
          "pattern": "^(?=\\S)(?=[\\s\\S]*\\S$)[\\x00-\\x7F]+$"
        },
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        },
        "description": "Canonical English machine skill keys mapped to non-negative integers, including exact Credit Rating. For guided Quick Fire, runtime requires the package-owned standard 1920s sheet classification plus explicitly allocated optional grouped/uncommon skills and reconciles every value to catalog base plus allocation deltas. The selected cap of 75 applies to player-allocated/non-derived starting values; an unallocated formula/characteristic-derived standard base remains authoritative even when it is above 75."
      },
      "quick_fire_sheet": {
        "type": "object",
        "required": [
          "id",
          "name",
          "skills",
          "player_facing_sheet_zh"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/safe_id"
          },
          "name": {
            "$ref": "#/$defs/name"
          },
          "age": {
            "$ref": "#/$defs/age"
          },
          "era": {
            "type": "string",
            "enum": [
              "1920s"
            ],
            "description": "Optional closed guided-creation era. Omit to use the canonical 1920s default; no modern standard-sheet policy is currently owned."
          },
          "skills": {
            "$ref": "#/$defs/skills"
          },
          "player_facing_sheet_zh": {
            "$ref": "#/$defs/player_facing_sheet_zh"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "characteristics"
              ]
            },
            {
              "required": [
                "derived"
              ]
            }
          ]
        },
        "additionalProperties": true,
        "description": "Quick Fire must omit characteristics and derived; the deterministic runtime materializes both."
      },
      "quick_fire_creation": {
        "type": "object",
        "required": [
          "input_mode",
          "method",
          "characteristic_assignment_order",
          "luck_roll_total",
          "luck_roll_receipt",
          "skill_budget"
        ],
        "properties": {
          "input_mode": {
            "const": "guided_quick_fire"
          },
          "method": {
            "const": "quick_fire_array"
          },
          "characteristic_assignment_order": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "enum": [
                "STR",
                "CON",
                "SIZ",
                "DEX",
                "APP",
                "INT",
                "POW",
                "EDU"
              ]
            },
            "description": "Each canonical characteristic exactly once, in descending Quick Fire array-slot priority order."
          },
          "luck_roll_total": {
            "type": "integer",
            "minimum": 3,
            "maximum": 18,
            "description": "Authoritative 3D6 total. The runtime binds it to luck_roll_receipt and multiplies it by five."
          },
          "luck_roll_receipt": {
            "type": "object",
            "required": [
              "campaign_id",
              "decision_id",
              "roll_id"
            ],
            "properties": {
              "campaign_id": {
                "$ref": "#/$defs/safe_id",
                "description": "Current campaign that owns the canonical rules.roll_dice source receipt."
              },
              "decision_id": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*",
                "description": "Stable decision_id used by the exact Quick-Fire Luck roll."
              },
              "roll_id": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*",
                "description": "Exact roll_id returned by the canonical rules.roll_dice receipt."
              }
            },
            "additionalProperties": false,
            "description": "Compact reference to the current campaign's immutable Quick-Fire Luck source receipt."
          },
          "skill_budget": {
            "$ref": "#/$defs/skill_budget"
          }
        },
        "additionalProperties": true
      },
      "complete_sheet": {
        "type": "object",
        "required": [
          "id",
          "name",
          "characteristics",
          "derived",
          "skills"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/safe_id"
          },
          "name": {
            "$ref": "#/$defs/name"
          },
          "age": {
            "$ref": "#/$defs/age"
          },
          "characteristics": {
            "$ref": "#/$defs/characteristics"
          },
          "derived": {
            "$ref": "#/$defs/derived"
          },
          "skills": {
            "$ref": "#/$defs/skills"
          }
        },
        "additionalProperties": true,
        "description": "Complete machine sheet accepted only through the explicit import_complete_sheet path."
      },
      "complete_sheet_creation": {
        "description": "Explicit discriminator for importing an already complete sheet. Guided creation must use the deterministic Quick Fire branch.",
        "type": "object",
        "required": [
          "input_mode"
        ],
        "properties": {
          "input_mode": {
            "const": "import_complete_sheet"
          }
        },
        "additionalProperties": true
      },
      "player_facing_sheet_zh": {
        "type": "object",
        "required": [
          "display_name",
          "skills"
        ],
        "properties": {
          "display_name": {
            "$ref": "#/$defs/name"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "label",
                "value"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "skill_budget_account": {
        "type": "object",
        "required": [
          "budget",
          "spent",
          "allocations"
        ],
        "properties": {
          "budget": {
            "type": "integer",
            "minimum": 1
          },
          "spent": {
            "type": "integer",
            "minimum": 1
          },
          "allocations": {
            "type": "object",
            "propertyNames": {
              "pattern": "^(?=\\S)(?=[\\s\\S]*\\S$)[\\x00-\\x7F]+$"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Canonical skills.json key to added points. Runtime sums this map, checks it against spent/budget, and reconciles the final machine value."
          }
        },
        "additionalProperties": false
      },
      "skill_budget": {
        "type": "object",
        "required": [
          "occupation_points",
          "personal_interest_points"
        ],
        "properties": {
          "occupation_points": {
            "$ref": "#/$defs/skill_budget_account"
          },
          "personal_interest_points": {
            "$ref": "#/$defs/skill_budget_account"
          }
        },
        "additionalProperties": false,
        "description": "Narrow guided Quick Fire accounting gate. Runtime derives spent from both per-skill allocation maps, requires package standard-sheet/base reconciliation, checks personal-interest budget against INT*2, and applies the package-owned 75 cap to player-allocated/non-derived starting values. An unallocated formula/characteristic-derived standard base remains authoritative above 75; allocating any points to a derived base already above the cap is rejected explicitly. Occupation eligibility remains semantic Keeper judgment; this does not introduce a second occupation engine."
      }
    }
  }
}
