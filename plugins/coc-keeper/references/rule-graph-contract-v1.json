  "semantic_id_law": "Every model-visible identifier is a namespaced semantic id. Node ids begin with the exact node_kind plus a colon. Relation ids begin with relation:. Tokens after the kind are lowercase ASCII kebab-case. Evidence span ids are produced by the reused ModuleGraph evidence builder and remain kebab-case semantic ids. Machine hashes and digests are compiler-attached integrity evidence; a model must never author or relay them.",
  "semantic_id_pattern": "^[a-z][a-z0-9-]*(?::[a-z0-9][a-z0-9-]*)+$",
  "span_id_pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
  "semantic_id_namespaces": {
    "node": "{node_kind}:{ruleset_id}(:{kebab-token})+",
