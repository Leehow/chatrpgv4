#!/usr/bin/env bash
# pi-coc — project-local COC Keeper entry for Pi (scheme C).
# Isolated PI_CODING_AGENT_DIR, no built-in coding tools, fixed session + host prompt.
set -euo pipefail

SCRIPT_PATH=$0
if [ -L "$SCRIPT_PATH" ]; then
  # Resolve one level of symlink (PATH install) without requiring readlink -f.
  LINK_TARGET=$(ls -l "$SCRIPT_PATH" | sed 's/.* -> //')
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH=$LINK_TARGET ;;
    *) SCRIPT_PATH=$(CDPATH= cd -- "$(dirname "$SCRIPT_PATH")" && pwd)/$LINK_TARGET ;;
  esac
fi
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$SCRIPT_PATH")" && pwd)

is_repo_root() {
  dir=$1
  pkg=$dir/package.json
  [ -f "$pkg" ] || return 1
  grep -q '"name"[[:space:]]*:[[:space:]]*"@chatrpg/coc-keeper-pi"' "$pkg"
}

REPO_ROOT=
probe=$SCRIPT_DIR
while [ "$probe" != "/" ]; do
  if is_repo_root "$probe"; then
    REPO_ROOT=$probe
    break
  fi
  probe=$(CDPATH= cd -- "$probe/.." && pwd)
done

if [ -z "$REPO_ROOT" ]; then
  printf '%s\n' "pi-coc: cannot locate chatrpgv4 repo root from $SCRIPT_DIR" >&2
  exit 1
fi

# MCP launchers inherit Pi's environment and invoke `uv run`. Resolve the
# contract-required uv before Pi starts so a trimmed desktop PATH cannot turn
# into a late, opaque MCP child exit 127. Never accept a project venv shim:
# uv is the project environment manager, not a project dependency.
UV_PATH=
if command -v uv >/dev/null 2>&1; then
  UV_PATH=$(command -v uv)
elif [ -x "$HOME/.local/bin/uv" ]; then
  UV_PATH=$HOME/.local/bin/uv
else
  printf '%s\n' "pi-coc: required uv 0.11.16 was not found; add uv to PATH or install it at \$HOME/.local/bin/uv" >&2
  exit 1
fi
case "$UV_PATH" in
  */.venv/bin/uv)
    printf '%s\n' "pi-coc: refusing uv from .venv/bin; install required uv 0.11.16 outside the project virtual environment" >&2
    exit 1
    ;;
esac
UV_VERSION=$("$UV_PATH" --version 2>&1) || {
  printf '%s\n' "pi-coc: cannot run required uv at $UV_PATH" >&2
  exit 1
}
case "$UV_VERSION" in
  "uv 0.11.16"|"uv 0.11.16 "*) ;;
  *)
    printf '%s\n' "pi-coc: required uv 0.11.16, found '$UV_VERSION' at $UV_PATH" >&2
    exit 1
    ;;
esac
UV_DIR=$(CDPATH= cd -- "$(dirname "$UV_PATH")" && pwd)
PATH_CURRENT=${PATH:-}
case ":$PATH_CURRENT:" in
  *":$UV_DIR:"*) ;;
  *) PATH=$UV_DIR${PATH_CURRENT:+:$PATH_CURRENT} ;;
esac
export PATH

DEFAULT_COC_HOME=$REPO_ROOT/.pi/coc-agent
if [ -z "${PI_COC_AGENT_DIR:-}" ] && [ -z "${PI_CODING_AGENT_DIR:-}" ]; then
  # One-time move off the retired global home. Copy, never symlink.
  if [ ! -f "$DEFAULT_COC_HOME/settings.json" ] && [ -f "$HOME/.pi/coc-agent/settings.json" ]; then
    mkdir -p "$REPO_ROOT/.pi"
    cp -R "$HOME/.pi/coc-agent" "$DEFAULT_COC_HOME"
  fi
  PI_CODING_AGENT_DIR=$DEFAULT_COC_HOME
else
  PI_CODING_AGENT_DIR=${PI_COC_AGENT_DIR:-$PI_CODING_AGENT_DIR}
fi
export PI_CODING_AGENT_DIR
# Skill 3 scene supply is Pi-Coc-only. Direct extension probes and the retired
# semantic-source coordinator remain unaffected unless launched through pi-coc.
export COC_PI_SCENE_SUPPLY=1

HOST_SYSTEM_PROMPT=$REPO_ROOT/plugins/coc-keeper/pi/prompts/host-system.md
DEFAULT_SESSION_ID=${PI_COC_SESSION_ID:-coc-keeper}

# `pi-coc-setup` sets this. Onboarding runs the same prepared environment --
# uv, the PDF adapters, the pinned interpreters, the MCP transport -- and
# differs only in which extension, prompt and session it loads. Preparing that
# environment a second time in a second launcher is how the old opening path
# ended up with the same default written in four places.
ONBOARDING_ROLE=0
if [[ "${COC_PI_LAUNCH_ROLE:-}" == "onboarding" ]]; then
  ONBOARDING_ROLE=1
  HOST_SYSTEM_PROMPT=$REPO_ROOT/plugins/coc-keeper/pi/prompts/onboarding-system.md
  DEFAULT_SESSION_ID=${PI_COC_SESSION_ID:-coc-onboarding}
fi

# `pi-coc-build` sets this. A build is not a session at all: it is the
# host-agnostic driver loop run headless, with this track's model channel
# injected, on the environment this launcher just prepared. Same law as
# onboarding -- one launcher owns environment assembly, roles only say what
# runs on it.
BUILD_ROLE=0
if [[ "${COC_PI_LAUNCH_ROLE:-}" == "build" ]]; then
  BUILD_ROLE=1
fi

attached_ui_enabled() {
  case "${COC_PI_ATTACHED_UI:-}" in
    1|true|TRUE|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

# The web/Electron UI owns an app-local agent dir (models + auth) that the
# old runtime Keeper never needed to turn into a full pi-coc home. When the
# UI is attached, write the missing settings and tool binaries there so the
# same host can start. Bare TUI still fails closed with the bootstrap hint.
if [ ! -f "$PI_CODING_AGENT_DIR/settings.json" ]; then
  if attached_ui_enabled; then
    mkdir -p "$PI_CODING_AGENT_DIR/sessions"
    node -e '
      const fs = require("fs");
      const settingsPath = process.argv[1];
      const repoRoot = process.argv[2];
      const modelsPath = process.argv[3];
      const settings = {
        packages: [repoRoot],
        theme: "light",
        quietStartup: true,
      };
      try {
        const raw = JSON.parse(fs.readFileSync(modelsPath, "utf8"));
        const providers = raw.providers && typeof raw.providers === "object"
          ? raw.providers
          : raw;
        const ids = Object.keys(providers || {});
        if (ids.length) {
          settings.defaultProvider = ids[0];
          const models = providers[ids[0]] && providers[ids[0]].models;
          if (Array.isArray(models) && models[0] && models[0].id) {
            settings.defaultModel = models[0].id;
          }
        }
      } catch {
        /* models.json is optional; set_model from the UI fills this in */
      }
      fs.writeFileSync(settingsPath, JSON.stringify(settings, null, 2) + "\n");
    ' "$PI_CODING_AGENT_DIR/settings.json" "$REPO_ROOT" "$PI_CODING_AGENT_DIR/models.json"
    printf '%s\n' "pi-coc: wrote attached-UI agent settings at $PI_CODING_AGENT_DIR/settings.json" >&2
  else
    cat <<EOF >&2
pi-coc: missing COC agent home settings: $PI_CODING_AGENT_DIR/settings.json

One-time bootstrap (example):
  mkdir -p "$REPO_ROOT/.pi/coc-agent/sessions"
  cat > "$REPO_ROOT/.pi/coc-agent/settings.json" <<'JSON'
  {
    "defaultProvider": "xai",
    "defaultModel": "grok-4.6",
    "packages": ["$REPO_ROOT"],
    "theme": "light",
    "quietStartup": true
  }
  JSON
  # Copy credentials into this repo's COC home. Do not symlink ~/.pi.
  # cp /path/to/your/auth.json "$REPO_ROOT/.pi/coc-agent/auth.json"
  ln -sfn "$REPO_ROOT/plugins/coc-keeper/pi/bin/pi-coc" "\$HOME/.npm-global/bin/pi-coc"

See plugins/coc-keeper/pi/README.md for the dual-entry workflow.
EOF
    exit 1
  fi
fi

# Every repo-local launcher loads the package that owns that launcher. A stale
# primary-checkout path in a worktree's settings would make Pi load the wrong
# extension before role/profile assembly. Preserve every other setting and
# replace the file atomically in its own directory.
#
# Only FILESYSTEM-PATH packages are the launcher's business. Declarative
# entries (`npm:`, `git:`, `https:`, `ssh:`) name a version, not a checkout,
# so they cannot go stale this way -- and rewriting the whole array deleted
# them on every launch. That silently uninstalled `npm:@arhen/pi-core-subagent`,
# which provides the `subagent` tool the opening source coordinator is
# dispatched with, one boot after it was installed.
if [ -f "$PI_CODING_AGENT_DIR/settings.json" ]; then
  node -e '
    const fs = require("fs");
    const path = require("path");
    const { randomUUID } = require("crypto");
    const settingsPath = process.argv[1];
    const repoRoot = process.argv[2];
    const settings = JSON.parse(fs.readFileSync(settingsPath, "utf8"));
    const packages = Array.isArray(settings.packages) ? settings.packages : [];
    const declarative = packages.filter(
      (entry) => typeof entry === "string" && /^(npm|git|https|ssh):/.test(entry),
    );
    const next = [repoRoot, ...declarative];
    const unchanged = packages.length === next.length
      && packages.every((entry, index) => entry === next[index]);
    if (unchanged) process.exit(0);
    settings.packages = next;
    const tempPath = path.join(
      path.dirname(settingsPath),
      `.${path.basename(settingsPath)}.pi-coc-${process.pid}-${randomUUID()}.tmp`,
    );
    let fd;
    try {
      fd = fs.openSync(tempPath, "wx", fs.statSync(settingsPath).mode & 0o777);
      fs.writeFileSync(fd, JSON.stringify(settings, null, 2) + "\n", "utf8");
      fs.fsyncSync(fd);
      fs.closeSync(fd);
      fd = undefined;
      fs.renameSync(tempPath, settingsPath);
    } catch (error) {
      if (fd !== undefined) {
        try { fs.closeSync(fd); } catch { /* preserve the original failure */ }
      }
      try { fs.unlinkSync(tempPath); } catch { /* absent or already renamed */ }
      throw error;
    }
    process.stderr.write("pi-coc: pinned packages to the running Pi package\n");
  ' "$PI_CODING_AGENT_DIR/settings.json" "$REPO_ROOT"
fi

if [ ! -f "$HOST_SYSTEM_PROMPT" ]; then
  printf '%s\n' "pi-coc: missing host system prompt: $HOST_SYSTEM_PROMPT" >&2
  exit 1
fi

# pi-subagents discovers distributable custom agents only from the project
# `.pi/agents/` surface. Keep canonical definitions in the Pi package (tracked
# by git), then mirror only this owned prefix into the ignored runtime surface.
STEWARD_AGENT_SOURCE=$REPO_ROOT/plugins/coc-keeper/pi/agents
# Mirror into the play workspace when the UI sets COC_WORKSPACE (Electron
# payload is read-only). TUI keeps the repo-local `.pi/agents` surface.
STEWARD_AGENT_RUNTIME=${COC_WORKSPACE:-$REPO_ROOT}/.pi/agents
if [ ! -d "$STEWARD_AGENT_SOURCE" ]; then
  printf '%s\n' "pi-coc: missing bundled steward agents: $STEWARD_AGENT_SOURCE" >&2
  exit 1
fi
mkdir -p "$STEWARD_AGENT_RUNTIME"
for steward_agent in "$STEWARD_AGENT_SOURCE"/steward-*.md; do
  [ -f "$steward_agent" ] || continue
  target_agent=$STEWARD_AGENT_RUNTIME/$(basename "$steward_agent")
  if [ ! -f "$target_agent" ] || ! cmp -s "$steward_agent" "$target_agent"; then
    cp "$steward_agent" "$target_agent"
  fi
done

# The opening source coordinator is the only way past
# `opening_source_review_required`, and it was never mirrored anywhere:
# dispatching it failed with `Unknown agent: "coc-opening-source-coordinator"`
# while the campaign sat at that gate. `@arhen/pi-core-subagent` discovers
# agents from the project `.pi/agents` surface, the same place the stewards
# are mirrored to, so the coordinators go beside them.
COORDINATOR_AGENT_SOURCE=$REPO_ROOT/plugins/coc-keeper/agents
COORDINATOR_AGENT_RUNTIME=$STEWARD_AGENT_RUNTIME
if [ -d "$COORDINATOR_AGENT_SOURCE" ]; then
  mkdir -p "$COORDINATOR_AGENT_RUNTIME"
  for coordinator_agent in "$COORDINATOR_AGENT_SOURCE"/coc-*-coordinator.md; do
    [ -f "$coordinator_agent" ] || continue
    target_agent=$COORDINATOR_AGENT_RUNTIME/$(basename "$coordinator_agent")
    if [ ! -f "$target_agent" ] || ! cmp -s "$coordinator_agent" "$target_agent"; then
      cp "$coordinator_agent" "$target_agent"
    fi
  done
fi

# Play workspace (campaign `.coc/`) may differ from the package repo root.
# The web/Electron UI sets COC_WORKSPACE to the player workspace; TUI and
# repo-local `pi-coc` keep the historical "cwd is the package root" default.
if [ -n "${COC_WORKSPACE:-}" ]; then
  if [ ! -d "$COC_WORKSPACE" ]; then
    printf '%s\n' "pi-coc: COC_WORKSPACE is not a directory: $COC_WORKSPACE" >&2
    exit 1
  fi
  cd -- "$COC_WORKSPACE" || exit 1
else
  case "$(pwd -P)/" in
    "$REPO_ROOT"/*|"$REPO_ROOT"/) ;;
    *) cd -- "$REPO_ROOT" || exit 1 ;;
  esac
fi

resolve_pi_cli() {
  local adapter_root expected_version cli package_json installed_version
  adapter_root=$REPO_ROOT/runtime/adapters/keeper
  expected_version=$(node -e '
    const fs = require("fs");
    const packagePath = process.argv[1];
    const lockPath = process.argv[2];
    try {
      const manifest = JSON.parse(fs.readFileSync(packagePath, "utf8"));
      const lock = JSON.parse(fs.readFileSync(lockPath, "utf8"));
      const expected = manifest.dependencies?.["@earendil-works/pi-coding-agent"];
      const coding = lock.packages?.["node_modules/@earendil-works/pi-coding-agent"]?.version;
      const core = lock.packages?.["node_modules/@earendil-works/pi-agent-core"]?.version;
      if (typeof expected !== "string" || !/^\d+\.\d+\.\d+$/.test(expected)) {
        throw new Error("package.json must pin an exact pi-coding-agent version");
      }
      if (coding !== expected || core !== expected) {
        throw new Error(`package-lock.json must pin pi-coding-agent and pi-agent-core to ${expected}`);
      }
      process.stdout.write(expected);
    } catch (error) {
      process.stderr.write(`pi-coc: invalid bundled Pi version contract: ${error.message}\n`);
      process.exit(1);
    }
  ' "$adapter_root/package.json" "$adapter_root/package-lock.json") || return 1

  if [[ ${COC_PI_CLI+x} ]]; then
    cli=${COC_PI_CLI:-}
    if [[ -z "$cli" || "$cli" != /* || ! -f "$cli" || ! -x "$cli" ]]; then
      printf '%s\n' \
        "pi-coc: COC_PI_CLI must be an absolute executable file; refusing fallback" >&2
      return 1
    fi
    package_json=$(node -e '
      const fs = require("fs");
      const path = require("path");
      let cursor = path.dirname(fs.realpathSync(process.argv[1]));
      while (true) {
        const candidate = path.join(cursor, "package.json");
        if (fs.existsSync(candidate)) {
          try {
            const value = JSON.parse(fs.readFileSync(candidate, "utf8"));
            if (value.name === "@earendil-works/pi-coding-agent") {
              process.stdout.write(candidate);
              process.exit(0);
            }
          } catch { /* keep walking for the owning package */ }
        }
        const parent = path.dirname(cursor);
        if (parent === cursor) break;
        cursor = parent;
      }
      process.exit(1);
    ' "$cli") || {
      printf '%s\n' \
        "pi-coc: COC_PI_CLI is not owned by an @earendil-works/pi-coding-agent package; refusing fallback" >&2
      return 1
    }
  else
    package_json=$adapter_root/node_modules/@earendil-works/pi-coding-agent/package.json
    cli=$adapter_root/node_modules/@earendil-works/pi-coding-agent/dist/cli.js
    if [[ ! -f "$cli" || ! -x "$cli" || ! -f "$package_json" ]]; then
      printf '%s\n' \
        "pi-coc: bundled Pi ${expected_version} is missing or not executable at $cli" >&2
      printf '%s\n' \
        "Fix: run 'npm ci' in $adapter_root; a global Pi is not a patched substitute" >&2
      return 1
    fi
  fi

  installed_version=$(node -e '
    const fs = require("fs");
    try {
      const value = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
      if (value.name !== "@earendil-works/pi-coding-agent" || typeof value.version !== "string") {
        throw new Error("unexpected package identity");
      }
      process.stdout.write(value.version);
    } catch (error) {
      process.stderr.write(`pi-coc: cannot validate Pi package: ${error.message}\n`);
      process.exit(1);
    }
  ' "$package_json") || return 1
  if [[ "$installed_version" != "$expected_version" ]]; then
    printf '%s\n' \
      "pi-coc: required ${expected_version} from the repository contract, found ${installed_version} at $package_json" >&2
    return 1
  fi
  printf '%s\n' "$cli"
}
PI_CLI=$(resolve_pi_cli) || exit 1

# Pi looks up fd/rg under $PI_CODING_AGENT_DIR/bin. Bind PATH copies into this
# project home; never share ~/.pi/agent/bin.
if [ ! -x "$PI_CODING_AGENT_DIR/bin/fd" ] || [ ! -x "$PI_CODING_AGENT_DIR/bin/rg" ]; then
  mkdir -p "$PI_CODING_AGENT_DIR/bin"
  fd_src=$(command -v fd || true)
  if [ -n "$fd_src" ] && [ -x "$fd_src" ] && [ ! -x "$PI_CODING_AGENT_DIR/bin/fd" ]; then
    ln -sfn "$fd_src" "$PI_CODING_AGENT_DIR/bin/fd"
  fi
  rg_src=$(command -v rg || true)
  if [ -n "$rg_src" ] && [ -x "$rg_src" ] && [ ! -x "$PI_CODING_AGENT_DIR/bin/rg" ]; then
    ln -sfn "$rg_src" "$PI_CODING_AGENT_DIR/bin/rg"
  fi
  if [ ! -x "$PI_CODING_AGENT_DIR/bin/fd" ] || [ ! -x "$PI_CODING_AGENT_DIR/bin/rg" ]; then
    printf '%s\n' "pi-coc: missing fd/rg under $PI_CODING_AGENT_DIR/bin" >&2
    printf '%s\n' "Fix: put fd and rg on PATH, then relaunch pi-coc" >&2
    exit 1
  fi
fi

# The build role never reaches session assembly: it execs the driver loop
# here, with this launcher's resolved Pi CLI exported for the injected model
# channel (a `.js` CLI is spawned through `node` by the adapter, exactly as
# the exec below does). Every other argument is the driver's own.
if [[ "$BUILD_ROLE" -eq 1 ]]; then
  export COC_PI_CLI=$PI_CLI
  export PYTHONPATH="$REPO_ROOT/plugins/coc-keeper/pi/lib${PYTHONPATH:+:$PYTHONPATH}"
  exec "$UV_PATH" run --project "$REPO_ROOT" --frozen python \
    "$REPO_ROOT/plugins/coc-keeper/scripts/coc_module_build.py" \
    --adapter build_ask_adapter "$@"
fi

# Wrapper-only --new: open a fresh Pi session (omit default session-id).
# Wrapper-only --campaign: select an existing COC campaign independently of
# Pi's transcript/session identity and expose it only to the package extension.
WANT_NEW=0
USER_SESSION_OPT=0
CAMPAIGN_SELECTOR_SET=0
if [[ ${PI_COC_CAMPAIGN_ID+x} ]]; then
  CAMPAIGN_SELECTOR_SET=1
fi
USER_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --new)
      WANT_NEW=1
      shift
      continue
      ;;
    --campaign)
      if [[ $# -lt 2 ]]; then
        printf '%s\n' "pi-coc: --campaign requires a campaign_id argument" >&2
        exit 2
      fi
      PI_COC_CAMPAIGN_ID=$2
      CAMPAIGN_SELECTOR_SET=1
      shift 2
      continue
      ;;
    --session|--session-id|--fork|-c|--continue|--resume|-r|--no-session)
      USER_SESSION_OPT=1
      ;;
  esac
  USER_ARGS+=("$1")
  shift
done

if [[ "$ONBOARDING_ROLE" -eq 1 && "$CAMPAIGN_SELECTOR_SET" -eq 0 ]]; then
  printf '%s\n' "pi-coc-setup: --campaign <id> is required; onboarding builds exactly one campaign" >&2
  exit 2
fi
if [[ "$CAMPAIGN_SELECTOR_SET" -eq 1 ]]; then
  node "$SCRIPT_DIR/../lib/campaign-id.mjs" "$PI_COC_CAMPAIGN_ID"
  export PI_COC_CAMPAIGN_ID
fi

# Role-scoped skills/prompt when --campaign is set and the role CLI succeeds.
# Failure or no campaign selector keeps the historical full-package + legacy prompt.
# Re-entered after setup handoff (exit 42) so play skills/prompt replace setup.
HOST_SYSTEM_PROMPT_DEFAULT=$HOST_SYSTEM_PROMPT
SESSION_SKILL_ARGS=()

assemble_campaign_role() {
  # `pi-coc` is the table. Onboarding is `pi-coc-setup`, a separate process
  # with its own extension and prompt, so this launcher no longer resolves a
  # setup/play split: it either opens a campaign that is ready, or says which
  # command makes it ready. Inferring a "setup" role here is what kept a whole
  # opening state machine alive inside the play host.
  if [[ "$ONBOARDING_ROLE" -eq 1 ]]; then
    return 0
  fi
  HOST_SYSTEM_PROMPT=$HOST_SYSTEM_PROMPT_DEFAULT
  SESSION_SKILL_ARGS=()
  export COC_PI_SESSION_ROLE=play
  # Same workspace the host will use. Reading `$(pwd)` instead made the check
  # disagree with the session it gates whenever COC_WORKSPACE was set.
  CAMPAIGN_WORKSPACE=${COC_WORKSPACE:-$(pwd)}
  CAMPAIGN_JSON=$CAMPAIGN_WORKSPACE/.coc/campaigns/$PI_COC_CAMPAIGN_ID/campaign.json
  if [[ ! -f "$CAMPAIGN_JSON" ]]; then
    printf '%s\n' "pi-coc: no campaign at $CAMPAIGN_JSON" >&2
    printf '%s\n' "pi-coc: build one first with: pi-coc-setup --campaign $PI_COC_CAMPAIGN_ID" >&2
    exit 3
  fi
  if ! node -e '
    const fs = require("fs");
    const campaign = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    const ready = campaign.status === "ready_for_table" || campaign.status === "active";
    process.exit(ready ? 0 : 1);
  ' "$CAMPAIGN_JSON" 2>/dev/null; then
    printf '%s\n' "pi-coc: campaign $PI_COC_CAMPAIGN_ID is not ready for the table" >&2
    printf '%s\n' "pi-coc: finish it with: pi-coc-setup --campaign $PI_COC_CAMPAIGN_ID" >&2
    exit 3
  fi
  MANIFEST=$REPO_ROOT/plugins/coc-keeper/pi/session-roles.json
  if [[ ! -f "$MANIFEST" ]]; then
    printf '%s\n' "pi-coc: missing session-roles.json; using full skill set" >&2
    return 0
  fi
  ROLE_PACK=$(node -e '
    const fs = require("fs");
    const path = require("path");
    const manifestPath = process.argv[1];
    const repoRoot = process.argv[2];
    const acceptanceProfile = process.argv[3];
    let manifest;
    try {
      manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
    } catch (err) {
      process.stderr.write("pi-coc: session-roles.json unreadable; using full skill set\n");
      process.exit(1);
    }
    const profileEntry = (
      acceptanceProfile === "rules-director-single-draft"
      && manifest.profiles
      && manifest.profiles[acceptanceProfile]
      && manifest.profiles[acceptanceProfile].role === "play"
    ) ? manifest.profiles[acceptanceProfile] : null;
    const entry = profileEntry || manifest.play;
    if (!entry || !Array.isArray(entry.skills) || typeof entry.prompt !== "string") {
      process.stderr.write("pi-coc: session-roles.json missing play; using full skill set\n");
      process.exit(1);
    }
    const prompt = path.join(repoRoot, entry.prompt);
    const skills = entry.skills.map((rel) => path.join(repoRoot, rel));
    process.stdout.write([prompt, ...skills].join("\n"));
  ' "$MANIFEST" "$REPO_ROOT" "${COC_PI_ACCEPTANCE_PROFILE:-}") || ROLE_PACK=
  if [[ -z "${ROLE_PACK}" ]]; then
    return 0
  fi
  PROMPT_LINE=
  SKILL_LINES=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$PROMPT_LINE" ]]; then
      PROMPT_LINE=$line
    else
      SKILL_LINES+=("$line")
    fi
  done <<< "$ROLE_PACK"
  if [[ -n "$PROMPT_LINE" && ! -f "$PROMPT_LINE" ]]; then
    printf '%s\n' "pi-coc: missing role prompt $PROMPT_LINE; falling back to host-system.md" >&2
    PROMPT_LINE=$HOST_SYSTEM_PROMPT
  fi
  if [[ -n "$PROMPT_LINE" && -f "$PROMPT_LINE" ]]; then
    HOST_SYSTEM_PROMPT=$PROMPT_LINE
  fi
  SESSION_SKILL_ARGS=(--no-skills)
  for skill_path in "${SKILL_LINES[@]+"${SKILL_LINES[@]}"}"; do
    [[ -n "$skill_path" ]] || continue
    SESSION_SKILL_ARGS+=(--skill "$skill_path")
  done
}

build_pi_args() {
  PI_ARGS=(
    --no-builtin-tools
    --approve
    --no-context-files
  )
  if [[ "$ONBOARDING_ROLE" -eq 1 ]]; then
    # Isolation is the point: onboarding never loads the Keeper host, so it
    # cannot inherit a phase machine, a play tool surface, or a projection
    # registry that only makes sense at the table. `--no-extensions` turns
    # discovery off and the one extension it needs is named explicitly.
    #
    # It no longer loads the subagent package either. That was here for the
    # opening-fast-facts review, which is retired: reading the source is the
    # module graph's job, and onboarding dispatches nothing.
    ONBOARDING_EXTENSION=$REPO_ROOT/plugins/coc-keeper/pi/extensions/onboarding/index.ts
    if [ ! -f "$ONBOARDING_EXTENSION" ]; then
      printf '%s\n' "pi-coc-setup: missing onboarding extension: $ONBOARDING_EXTENSION" >&2
      exit 1
    fi
    PI_ARGS+=(--no-extensions -e "$ONBOARDING_EXTENSION")
  fi
  if ((${#SESSION_SKILL_ARGS[@]} > 0)); then
    PI_ARGS+=("${SESSION_SKILL_ARGS[@]}")
  fi
  PI_ARGS+=(--append-system-prompt "$HOST_SYSTEM_PROMPT")
  if [[ "$WANT_NEW" -eq 0 && "$USER_SESSION_OPT" -eq 0 ]]; then
    PI_ARGS+=(--session-id "$DEFAULT_SESSION_ID")
  fi
  if [[ -n "${IMPLICIT_THINKING_LEVEL:-}" ]]; then
    PI_ARGS+=(--thinking "$IMPLICIT_THINKING_LEVEL")
  fi
  # Under `set -u`, expanding an empty array as "${USER_ARGS[@]}" is unbound on
  # some bash builds (e.g. macOS). Only append when the user passed args.
  if ((${#USER_ARGS[@]} > 0)); then
    PI_ARGS+=("${USER_ARGS[@]}")
  fi
}

# Pi clamps unsupported thinking levels before extensions load. Guard the
# original request here so `--thinking off` can never become a silent `low`.
IMPLICIT_THINKING_LEVEL=$(node "$SCRIPT_DIR/pi-coc-thinking-preflight.mjs" \
  "$PI_CODING_AGENT_DIR" "${USER_ARGS[@]+"${USER_ARGS[@]}"}")

# Auto-configure bundled adapters (user env overrides win).
export COC_PI_SOURCE_SCOPE_LOCATOR_COMMAND="${COC_PI_SOURCE_SCOPE_LOCATOR_COMMAND:-$SCRIPT_DIR/coc-pdf-skill-adapter.py}"
export COC_PROGRESSIVE_OCR_COMMAND="${COC_PROGRESSIVE_OCR_COMMAND:-$SCRIPT_DIR/coc-ocr-adapter.py}"
# External Firecrawl pdf-inspector router: stable user install outside the
# repo ($HOME/.pi/coc-tools/pdf-inspector/), because the AGENTS PDF contract
# keeps parsers out of the repository. The adapter validates the path and
# falls back to the Pi PDF-skill path (locator/full-parse) or the locator's
# bound pages (opening review) when the file is missing, so a stale default
# is harmless. User env overrides win.
export COC_PI_PDF_INSPECTOR_COMMAND="${COC_PI_PDF_INSPECTOR_COMMAND:-$HOME/.pi/coc-tools/pdf-inspector/coc-pi-pdf-inspector-router}"
# Adapter child model defaults (user env overrides win):
#   COC_PI_PDF_MODEL     locator/full-parse visual PDF-skill child
#   COC_PI_OPENING_MODEL opening facts+L0 text extractor — never a vision
#                       model; it reads router-materialized Markdown only
#
# Both default to the same provider on purpose. The opening extractor used to
# default to a DeepSeek text model, and "text-only" is an argument for a text
# model, not for a second provider: it dragged another credential into a chain
# that otherwise runs entirely on the session's own. On 2026-09-02 that
# credential was invalid and every opening source review died after rendering
# its pages, on a 401 for a provider nothing else in the run touches.
#
# This export is also why fixing the adapter's own constant did nothing --
# the env wins over it. The default lived in four places at once (this export,
# the adapter constant, the child-env allowlist, and a `model_policy` field
# that is validated and never consumed). Anything else, DeepSeek included,
# still works by setting COC_PI_OPENING_MODEL.
export COC_PI_PDF_MODEL="${COC_PI_PDF_MODEL:-xai/grok-4.6}"
export COC_PI_OPENING_MODEL="${COC_PI_OPENING_MODEL:-$COC_PI_PDF_MODEL}"

# Quiet game desktop: suppress pi update/package/changelog noise inside the
# pi-coc session. PI_OFFLINE disables startup network operations (version
# check, package update check, install/update telemetry) and pi maps it to
# PI_SKIP_VERSION_CHECK as well. Users may re-enable the checks by exporting
# PI_OFFLINE=0 before launching pi-coc.
export PI_OFFLINE="${PI_OFFLINE:-1}"
export PI_SKIP_VERSION_CHECK="${PI_SKIP_VERSION_CHECK:-1}"

# The two bundled adapters need *different* interpreters, so neither may be
# left to whatever `python3` the user's shell resolves first.
#
#   pdf-skill adapter : imports repository modules, which refuse to load on
#                       anything but the pinned CPython.
#   baiduocr bridge   : needs `requests`, which is deliberately not a
#                       repository dependency and so is absent from .venv.
#
# No single ambient interpreter satisfies both. Pin each one explicitly here:
# capture a requests-capable interpreter from the user's own PATH first, then
# put the project interpreter in front for everything else. A pre-set
# COC_PROGRESSIVE_OCR_PYTHON that cannot import requests (e.g. the project
# venv) is treated as unset so the probe can still find a working one.
if [ -n "${COC_PROGRESSIVE_OCR_PYTHON:-}" ]; then
  if ! "$COC_PROGRESSIVE_OCR_PYTHON" -c "import requests" >/dev/null 2>&1; then
    unset COC_PROGRESSIVE_OCR_PYTHON
  fi
fi
if [ -z "${COC_PROGRESSIVE_OCR_PYTHON:-}" ]; then
  # Prefer versioned interpreters before bare python3: many machines resolve
  # python3 to a venv or a brew shim without requests, while python3.11 has it.
  for candidate in python3.11 python3.10 python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 \
      && "$candidate" -c "import requests" >/dev/null 2>&1; then
      COC_PROGRESSIVE_OCR_PYTHON=$(command -v "$candidate")
      export COC_PROGRESSIVE_OCR_PYTHON
      break
    fi
  done
fi

# Packaged desktop relocates the project env to UV_PROJECT_ENVIRONMENT
# (userData/coc-venv). Missing $REPO_ROOT/.venv is expected there and is
# not a PDF-only failure — do not scare built-in-module launches.
if [ -n "${UV_PROJECT_ENVIRONMENT:-}" ] && [ -x "$UV_PROJECT_ENVIRONMENT/bin/python3" ]; then
  PATH=$UV_PROJECT_ENVIRONMENT/bin:$PATH
  export PATH
elif [ -x "$REPO_ROOT/.venv/bin/python3" ]; then
  PATH=$REPO_ROOT/.venv/bin:$PATH
  export PATH
else
  printf '%s\n' "pi-coc: no project python at ${UV_PROJECT_ENVIRONMENT:-$REPO_ROOT/.venv}/bin/python3; run 'uv sync --frozen'" >&2
fi

run_pi() {
  case "$PI_CLI" in
    *.js|*.mjs)
      node "$PI_CLI" "${PI_ARGS[@]}"
      ;;
    *)
      "$PI_CLI" "${PI_ARGS[@]}"
      ;;
  esac
}

# The setup-handoff re-exec (exit 42, re-resolve role, start play once) is
# gone with the setup role: onboarding is its own process and its own command,
# so a play launch either opens a ready campaign or refuses and names
# `pi-coc-setup`. One exec, no loop.
if [[ "$CAMPAIGN_SELECTOR_SET" -eq 1 ]]; then
  assemble_campaign_role
fi
build_pi_args
case "$PI_CLI" in
  *.js|*.mjs)
    exec node "$PI_CLI" "${PI_ARGS[@]}"
    ;;
  *)
    exec "$PI_CLI" "${PI_ARGS[@]}"
    ;;
esac
