{
  "id": "natural-npc",
  "version": "1.7.4",
  "game_api": "pipicoc.game.v1",
  "state_version": 1,
  "author": "PipiCOC",
  "name": {
    "zh-Hans": "自然 NPC 行为",
    "en": "Natural NPC"
  },
  "description": "People with individual temperaments, values, speech habits and changing feelings: reusable random-table seeds for every person, first impressions when they matter, and language limits grounded in the investigator's sheet.",
  "default_enabled": true,
  "requires": [
    "checks.percentile.v1",
    "checks.presence.v1",
    "context.npc.v1",
    "graph.vocabulary.v1",
    "graph.vocabulary.table.v1",
    "npc.variation-tables.v1",
    "npc.mood.v1",
    "mods.package-files.v1",
    "instructions.sections.v1"
  ],
  "package_files": [
    "agent.md",
    "sections.json",
    "character-tables.json",
    "auditor.md"
  ],
  "dependencies": {},
  "conflicts": [],
  "settings": {
    "language_mixing": "light"
  },
  "settings_schema": {
    "language_mixing": {
      "enum": [
        "off",
        "light",
        "full"
      ]
    }
  },
  "contributes": {
    "instructions": "agent.md",
    "sections": "sections.json",
    "npc_variation": "character-tables.json",
    "auditor": "auditor.md",
    "vocabulary": {
      "actor_profile_keys": [
        {
          "key": "language",
          "label": "speaks",
          "ask": "the language or dialect this person speaks, and how well, when the book says so"
        }
      ]
    },
    "checks": [
      {
        "name": "natural-npc:first-impression",
        "trigger": "presence",
        "scope": "actor-target",
        "values": [
          {
            "path": "characteristics.APP",
            "label": "Appearance"
          },
          {
            "path": "skills.Credit Rating",
            "label": "Credit Rating"
          }
        ],
        "selection": "maximum",
        "difficulty": "regular",
        "reusable": true,
        "legacy": {
          "format": "npc-first-impression",
          "file": "save/npc-first-impressions.json"
        },
        "results": {
          "critical": {
            "reaction": "breakthrough",
            "disposition": "helpful"
          },
          "extreme": {
            "reaction": "strongly_favorable",
            "disposition": "helpful"
          },
          "hard": {
            "reaction": "favorable",
            "disposition": "helpful"
          },
          "regular": {
            "reaction": "open",
            "disposition": "neutral"
          },
          "failure": {
            "reaction": "guarded",
            "disposition": "neutral"
          },
          "fumble": {
            "reaction": "actively_adverse",
            "disposition": "hostile"
          }
        },
        "rule_refs": [
          "keeper-rulebook p.191",
          "percentile-check",
          "success-levels"
        ]
      }
    ]
  }
}
