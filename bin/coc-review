#!/usr/bin/env bash
# 读者的闸门（契约 §14.5）：bin/coc-review --module <id> --section <id> [--workspace <dir>]
# 即 module.review：三道确定性门，打印 findings，通过时退出码 0。
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/.." && pwd)"
export PYTHONPATH="$REPO/kernel${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1
exec uv run --frozen --project "$REPO" python -m coc.modules.review_cli "$@"
