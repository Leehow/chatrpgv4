#!/usr/bin/env bash
# The reader's evidence tool (contract §14.5): search / verify / page / outline / read / coverage
# over one extraction packet.
# Usage: bin/coc-evidence [--packet <work_dir>/packet.json] search <name>
#        bin/coc-evidence verify <span-id>[,<span-id>...]
#        bin/coc-evidence page <pdf_index>
# Reads packet.json in the current directory by default.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/.." && pwd)"
export PYTHONPATH="$REPO/kernel${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1
exec uv run --frozen --project "$REPO" python -m coc.modules.evidence "$@"
