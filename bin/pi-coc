#!/bin/bash
# Canonical source or standalone Pi launcher. Process and profile composition live in runtime/launch.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PI_COC_RESOURCE_ROOT="$root"
if [ -f "$root/deployment.json" ] || [ "${PI_COC_LAYOUT:-}" = compiled ]; then
  export PI_COC_LAYOUT=compiled
  unset NODE_OPTIONS NODE_PATH ELECTRON_RUN_AS_NODE
  runner="$root/node/bin/node"
  entry="$root/build/runtime/launch.mjs"
  [ -x "$runner" ] && [ -f "$entry" ] || { echo 'The standalone COC runtime is incomplete.' >&2; exit 1; }
else
  export PI_COC_LAYOUT=source
  runner="${PI_COC_NODE_EXECUTABLE:-$(command -v node)}"
  entry="$root/build/runtime/launch.mjs"
fi
[ -f "$entry" ] || { echo 'The COC JavaScript runtime is missing. Run npm run build:runtime first.' >&2; exit 1; }
export PI_COC_NODE_EXECUTABLE="$runner"
exec "$runner" "$entry" "$@"
