#!/usr/bin/env bash
# The pi-coc launcher. Contract in docs/kernel-rpc.md §9 and §14.4 (the setup process).
# Usage: bin/pi-coc [--campaign <id>] [pi args...]         open a table (play mode)
#        bin/pi-coc setup [--campaign <id>] [pi args...]   set up a game (setup mode)
#
# These environment variables are honoured (passed to pi verbatim and read by the extensions):
#   PI_COC_CAMPAIGN         campaign id, the same as --campaign
#   PI_COC_MODE             play|setup, exported by this script; the extensions register their tools by it (contract §14.4)
#   PI_COC_VERIFIER_MODEL   the verifier lane's model, as provider/model; defaults to the table's own model
#   PI_COC_MEMORY_MODEL     the memory extraction lane's model, likewise
#   PI_COC_BUILD_MODEL      the reader subprocess's model, likewise (contract §14.5)
#   PI_COC_BUILD_PARALLEL   the build concurrency cap, 1 by default (contract §14.5)
#   PI_COC_READER_TIMEOUT_MS the cap on one reader round, 15 minutes by default
#   PI_COC_BUILD_WAIT_MS    how long setup waits for opening readiness, 30 minutes by default; at the deadline it answers "still reading" and can wait again
# Lane models are in docs/pi-host-contract.md §3.1, the reader subprocess in §3.2.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/.." && pwd)"
PI_BIN="$REPO/node_modules/.bin/pi"
AGENT_DIR="$REPO/.pi/coc-agent"
SETTINGS="$AGENT_DIR/settings.json"

# A first positional argument of setup takes the setup process: another prompt page, another tool surface (contract §14.4).
mode="play"
if [ $# -gt 0 ] && [ "$1" = "setup" ]; then
	mode="setup"
	shift
fi

if [ "$mode" = "setup" ]; then
	PROMPT="$REPO/prompts/setup.md"
	PROMPT_WHAT="the setup prompt"
else
	PROMPT="$REPO/prompts/keeper.md"
	PROMPT_WHAT="the Keeper prompt"
fi

if [ ! -x "$PI_BIN" ]; then
	echo "Cannot find $PI_BIN. Run npm install in $REPO first." >&2
	exit 1
fi
if [ ! -f "$PROMPT" ]; then
	echo "Cannot find ${PROMPT_WHAT} at $PROMPT." >&2
	exit 1
fi

campaign="${PI_COC_CAMPAIGN:-}"
args=()
while [ $# -gt 0 ]; do
	case "$1" in
		--campaign)
			if [ $# -lt 2 ]; then
				echo "--campaign must be followed by a campaign id." >&2
				exit 1
			fi
			campaign="$2"
			shift 2
			;;
		--campaign=*)
			campaign="${1#--campaign=}"
			shift
			;;
		*)
			args+=("$1")
			shift
			;;
	esac
done

mkdir -p "$AGENT_DIR"
if [ ! -f "$SETTINGS" ]; then
	printf '{\n  "packages": ["%s"],\n  "quietStartup": true\n}\n' "$REPO" >"$SETTINGS"
else
	# An existing settings file gets one addition only: this repository in packages.
	SETTINGS="$SETTINGS" REPO="$REPO" node -e '
		const fs = require("node:fs");
		const path = process.env.SETTINGS;
		const repo = process.env.REPO;
		let settings;
		try {
			settings = JSON.parse(fs.readFileSync(path, "utf8"));
		} catch (error) {
			console.error(`${path} is not valid JSON: ${error.message}`);
			process.exit(1);
		}
		if (settings === null || typeof settings !== "object" || Array.isArray(settings)) {
			console.error(`${path} is not an object at the top level; fix it by hand.`);
			process.exit(1);
		}
		const packages = Array.isArray(settings.packages) ? settings.packages : [];
		if (!packages.includes(repo)) {
			settings.packages = [...packages, repo];
			fs.writeFileSync(path, `${JSON.stringify(settings, null, 2)}\n`);
		}
	'
fi

if [ -n "$campaign" ]; then
	export PI_COC_CAMPAIGN="$campaign"
fi
export PI_CODING_AGENT_DIR="$AGENT_DIR"
export PI_COC_MODE="$mode"

cd "$REPO"
session_args=()
if [ -n "$campaign" ]; then
	# Setup and play are two processes with two records: the session ids stay apart, so setup's questions never mix into the table's session.
	if [ "$mode" = "setup" ]; then
		session_args=(--session-id "coc-setup-$campaign")
	else
		session_args=(--session-id "coc-$campaign")
	fi
fi

exec "$PI_BIN" \
	--no-builtin-tools \
	--no-context-files \
	--system-prompt "$PROMPT" \
	${session_args[@]+"${session_args[@]}"} \
	${args[@]+"${args[@]}"}
