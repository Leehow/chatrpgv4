{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 4
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "interactions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/interaction"
      }
    },
    "reveal": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/existing"
      }
    }
  },
  "$defs": {
    "ref": {
      "enum": [
        "investigator_1",
        "npc_1",
        "npc_2",
        "cafe",
        "clinic",
        "bar",
        "coffee",
        "clinic_hours",
        "last_seen_doctor",
        "paid_pickup",
        "spare_film_ownership",
        "source_clinic_hours"
      ]
    },
    "npc": {
      "enum": [
        "npc_1",
        "npc_2"
      ]
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "existing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fact_ref": {
          "$ref": "#/$defs/ref"
        },
        "source_ref": {
          "$ref": "#/$defs/ref"
        }
      },
      "oneOf": [
        {
          "required": [
            "fact_ref"
          ]
        },
        {
          "required": [
            "source_ref"
          ]
        }
      ]
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day_offset",
        "hour",
        "minute"
      ],
      "properties": {
        "day_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 365
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        }
      }
    },
    "newFact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "predicate",
            "provider",
            "items",
            "when",
            "fulfillment"
          ],
          "properties": {
            "predicate": {
              "const": "service_at"
            },
            "provider": {
              "$ref": "#/$defs/npc"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/ref"
              }
            },
            "when": {
              "$ref": "#/$defs/when"
            },
            "fulfillment": {
              "enum": [
                "dine_in",
                "takeaway"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "predicate",
            "actor",
            "to",
            "when"
          ],
          "properties": {
            "predicate": {
              "const": "planned_visit"
            },
            "actor": {
              "$ref": "#/$defs/npc"
            },
            "to": {
              "$ref": "#/$defs/ref"
            },
            "when": {
              "$ref": "#/$defs/when"
            }
          }
        }
      ]
    },
    "content": {
      "oneOf": [
        {
          "$ref": "#/$defs/existing"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new"
          ],
          "properties": {
            "new": {
              "$ref": "#/$defs/newFact"
            }
          }
        }
      ]
    },
    "interaction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor",
            "act"
          ],
          "properties": {
            "actor": {
              "$ref": "#/$defs/npc"
            },
            "act": {
              "const": "silent"
            },
            "to": {
              "$ref": "#/$defs/people"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor",
            "to",
            "act"
          ],
          "properties": {
            "actor": {
              "$ref": "#/$defs/npc"
            },
            "to": {
              "$ref": "#/$defs/people"
            },
            "act": {
              "enum": [
                "answer",
                "ask",
                "offer",
                "report",
                "warn",
                "clarify",
                "greet",
                "acknowledge",
                "refuse"
              ]
            },
            "content": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/content"
              }
            },
            "channel_ref": {
              "$ref": "#/$defs/ref"
            },
            "overhearers": {
              "$ref": "#/$defs/people"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "act": {
                    "enum": [
                      "answer",
                      "ask",
                      "offer",
                      "report",
                      "warn",
                      "clarify"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "content"
                ]
              }
            }
          ]
        }
      ]
    },
    "command": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "to"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "move"
            },
            "to": {
              "enum": [
                "cafe",
                "clinic",
                "bar"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "service",
            "crowd"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "scene"
            },
            "service": {
              "type": "string",
              "enum": [
                "open",
                "closed",
                "limited",
                "unknown"
              ]
            },
            "crowd": {
              "type": "string",
              "enum": [
                "empty",
                "quiet",
                "active",
                "crowded",
                "unknown"
              ]
            },
            "review_after_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
