#!/bin/zsh
# 换 KP 模型 / 放 key 的小工具。用法:
#   ./kp            列出能用的模型
#   ./kp glm        换成 glm-5.2 (thinking off,真能关)
#   ./kp glm53      换成 glm-5.3-flash (强制思考,预检查会拦)
#   ./kp grok       换成 grok-4.5
#   ./kp key <名字> 放一把 key(不回显,不进终端历史)
set -e
cd "${0:A:h}"

# ONE tracked driver serves every workspace. RPC_WORKSPACE points it at this
# worktree instead of its own directory; an untracked copy at this root is
# exactly the divergence the driver's own docstring warns about, and which
# recurred on 2026-09-02.
DRIVER="tests/pi/_lib/rpc-driver.py"
export RPC_WORKSPACE="$PWD"
export RPC_EVIDENCE_DIR="${RPC_EVIDENCE_DIR:-.rpc-evidence-run3}"
export PI_COC_LAUNCHER="$PWD/plugins/coc-keeper/pi/bin/pi-coc"
export PI_CODING_AGENT_DIR="$PWD/.pi/coc-agent"
export PI_COC_CAMPAIGN_ID="${PI_COC_CAMPAIGN_ID:-${COC_PI_CAMPAIGN_ID:-amaranthine-run3}}"

case "$1" in
  key)
    [[ -z "$2" ]] && { echo "用法: ./kp key zai-coding-cn"; exit 1; }
    read -s "K?粘贴 $2 的 key 然后回车: "; echo
    K="$K" P="$2" python3 -c "
import json,os,pathlib
p=pathlib.Path('.pi/coc-agent/auth.json')
d=json.loads(p.read_text())
d[os.environ['P']]={'type':'api_key','key':os.environ['K']}
p.write_text(json.dumps(d,indent=2)+chr(10))
print('已写入',os.environ['P'],'凭据')"
    unset K
    exit 0
    ;;
  ""|list)
    python3 -c "
import json,pathlib
d=json.loads(pathlib.Path('.pi/coc-agent/models.json').read_text())
auth=set(json.loads(pathlib.Path('.pi/coc-agent/auth.json').read_text()))
print('能用的模型(有钥匙的):')
for name,p in d['providers'].items():
    mark='✓' if name in auth else '  (缺 key)'
    for m in (p.get('models') or [])[:6]:
        print(f\"  {mark} {name}/{m['id']}\")"
    exit 0
    ;;
  # Thinking level travels with the model on the LAUNCHER's own command line,
  # so no settings.json rewrite is needed: pi validates the pair it is given.
  glm)   MODEL=zai-coding-cn/glm-5.2;        THINK=off ;;
  glm53) MODEL=zai-coding-cn/glm-5.3-flash;  THINK=off ;;
  grok)  MODEL=xai/grok-4.5;                 THINK=low ;;
  *)     MODEL="$1";                         THINK="${2:-off}" ;;
esac

export PI_COC_MODEL="$MODEL" PI_COC_THINKING="$THINK"
uv run --frozen python "$DRIVER" stop >/dev/null 2>&1 || true
rm -f "$RPC_EVIDENCE_DIR/rpc-control.fifo" "$RPC_EVIDENCE_DIR/rpc-daemon.pid"
uv run --frozen python "$DRIVER" start >/dev/null
sleep 3
uv run --frozen python "$DRIVER" set-model "$MODEL" 2>&1 | grep -q '"success": true' \
  && echo "已切到 $MODEL (thinking $THINK),可以继续玩了" \
  || { echo "切换失败: $MODEL"; tail -2 "$RPC_EVIDENCE_DIR/pi-stderr.log" 2>/dev/null; exit 1; }
