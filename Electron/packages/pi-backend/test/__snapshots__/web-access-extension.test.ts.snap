      "type": "boolean",
    },
    "numResults": {
      "description": "Results per query (default: 5, max: 20)",
      "maximum": 20,
      "minimum": 1,
      "type": "integer",
    },
    "provider": {
      "anyOf": [
        {
          "enum": [
            "auto",
            "all",
            "openai",
            "brave",
            "parallel",
            "tinyfish",
            "search1api",
            "searchinfinity",
            "querit",
            "tavily",
            "firecrawl",
            "jina",
            "searxng",
            "duckduckgo",
            "perplexity",
            "gemini",
            "exa",
