{
  "name": "@pipi/pi-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "bundle:runtime-agents": "node scripts/bundle-runtime-agents.mjs",
    "prebuild": "node ../../../scripts/build-runtime.mjs && npm run build -w @pipi/account-usage-core && node scripts/bundle-runtime-agents.mjs",
    "build": "tsc -p tsconfig.json",
    "pretest": "node ../../../scripts/build-runtime.mjs && npm run build -w @pipi/account-usage-core && node scripts/bundle-runtime-agents.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@pipi/account-usage-core": "file:../account-usage-core",
    "@pipi/host-api": "file:../host-api",
    "pi-mcp-extension": "1.5.0",
    "pi-web-access": "0.23.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
