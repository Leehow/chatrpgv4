{
  // Spec D2: stable id, [a-z][a-z0-9-]*. Host refuses settings keys without ext.<id>.*
  "id": "__ID__",
  "name": "__NAME__",
  "version": "0.1.0",
  "category": "developer",
  // D8 enum: settings.read | settings.write | bridge.emit | invoke.agent | stream.render | terminal.read | notifications
  // Empty array = L0 only (no agent.extension / no controlled entry).
  "capabilities": [
    "settings.read",
    "settings.write",
    "bridge.emit",
    "invoke.agent",
    "stream.render"
  ],
  "dependencies": {
    "required": [],
    "optional": [],
    "conflicts": []
  },
  "agent": {
    "extension": "agent/dist/index.js"
    // Optional: contribute schema:1 AGENT.md packages (paths relative to this package).
    // Leave these commented until the files exist — missing files fail at load, not at scaffold.
    // "agents": ["agents/example/AGENT.md"],
    // Optional: patch an existing agent. appendPrompt and replacePrompt are mutually exclusive.
    // "agentPatches": [
    //   { "target": "explore", "appendPrompt": "prompts/explore-extra.md", "addTools": ["code_search"] }
    // ]
  },
  "app": {
    "settings": {
      "scope": "project",
      "schema": {
        "type": "object",
        "properties": {
          // Host rejects keys that are not ext.<id>.*
          "ext.__ID__.greeting": {
            "type": "string",
            "default": "hello",
            "title": "Greeting"
          }
        }
      }
    },
    "ui": {
      // v2 Workbench: declare a container first, then lazy views inside it.
      "viewContainers": [
        { "id": "__ID__.tools", "location": "auxiliarySidebar", "title": "__NAME__" }
      ],
      "views": [
        { "id": "__ID__.main", "container": "__ID__.tools", "entry": "app/dist/panel.js", "activation": "visible" }
      ],
      "toolRenderers": [
        { "tool": "__ID__", "entry": "app/dist/hello-card.js" }
      ],
      // No entry = schema form (preferred). Controlled components only when schema cannot express the UI.
      "settingsSections": [
        { "id": "__ID__", "title": "__NAME__" }
      ],
      "slashCommands": [
        { "name": "__ID__", "description": "Sample command from __NAME__" }
      ],
      "themes": [],
      "statusBar": []
    }
  },
  "settingsVersion": 1,
  "migrations": []
}
