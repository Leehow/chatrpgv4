{
  "name": "pi-coc",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "COC Keeper for Pi: seven verbs over a deterministic kernel",
  "keywords": [
    "pi-package",
    "coc",
    "trpg"
  ],
  "pi": {
    "extensions": [
      "./extensions/kernel",
      "./extensions/mods",
      "./extensions/onboarding",
      "./extensions/module",
      "./extensions/memory",
      "./extensions/npc",
      "./extensions/table",
      "./extensions/npc-journal",
      "./extensions/npc-voice",
      "./extensions/npc-epithets",
      "./extensions/node-handles",
      "./extensions/speech-edit",
      "./extensions/thinking-schedule",
      "./extensions/deepseek",
      "./extensions/image-gen",
      "./extensions/grok-build-oauth",
      "./extensions/rerank",
      "./extensions/jev"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build:runtime": "node scripts/build-runtime.mjs",
    "check:kernel": "tsc -p tsconfig.kernel.json",
    "test:ext": "node scripts/test-extension.mjs",
    "pretest:electron": "npm run build:runtime && npm --prefix Electron run build -w @pipi/host-api && npm --prefix Electron run build -w @pipiui/extension-api && npm --prefix Electron run build -w @pipi/account-usage-core && node Electron/packages/pi-backend/scripts/bundle-runtime-agents.mjs && npm --prefix Electron run build -w @pipiui/electron",
    "test:electron": "node Electron/scripts/suite-baseline.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.8",
    "fs-ext": "2.1.1",
    "lzma-purejs": "0.9.3",
    "pdfjs-dist": "6.3.289",
    "seek-bzip": "2.0.0",
    "yauzl": "3.4.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-codemode": "1.0.0",
    "@earendil-works/pi-mcp": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "quickjs-wasi": "3.6.2",
    "@silvia-odwyer/photon-node": "0.3.4",
    "chalk": "6.0.0",
    "cross-spawn": "7.0.6",
    "diff": "8.0.4",
    "grok-mermaid": "0.2.3",
    "highlight.js": "10.7.3",
    "hosted-git-info": "9.0.3",
    "ignore": "7.0.8",
    "jiti": "2.7.0",
    "minimatch": "10.2.6",
    "proper-lockfile": "4.1.2",
    "semver": "7.8.5",
    "typebox": "1.3.27",
    "undici": "8.10.2",
    "yaml": "2.9.0"
  }
}
