{
  "name": "pi-coc",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "COC Keeper for Pi: seven verbs over a deterministic Python kernel",
  "keywords": [
    "pi-package",
    "coc",
    "trpg"
  ],
  "pi": {
    "extensions": [
      "./extensions/kernel",
      "./extensions/mods",
      "./extensions/onboarding",
      "./extensions/module",
      "./extensions/memory",
      "./extensions/table",
      "./extensions/deepseek"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test:ext": "node --test \"tests/extension/**/*.test.mjs\"",
    "test:electron": "node Electron/scripts/suite-baseline.mjs",
    "check:kernel": "tsc -p tsconfig.kernel.json"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.8",
    "pdfjs-dist": "6.3.289",
    "fs-ext": "2.1.1"
  }
}
